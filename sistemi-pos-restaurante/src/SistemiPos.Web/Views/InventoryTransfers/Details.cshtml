@model SistemiPos.Web.Models.Inventory.InventoryTransferDetailViewModel
@using SistemiPos.Domain.Inventory
@{
    var transfer = Model.Transfer;
    ViewData["Title"] = $"Traslado {transfer.Number}";

    var statusClass = transfer.Status switch
    {
        InventoryTransferStatus.Draft => "status-warning",
        InventoryTransferStatus.Dispatched => "status-info",
        InventoryTransferStatus.Received => "status-success",
        InventoryTransferStatus.Cancelled => "status-danger",
        _ => "status-neutral"
    };
    var statusLabel = transfer.Status switch
    {
        InventoryTransferStatus.Draft => "Borrador",
        InventoryTransferStatus.Dispatched => "Despachado (En tránsito)",
        InventoryTransferStatus.Received => "Recibido en destino",
        InventoryTransferStatus.Cancelled => "Cancelado",
        _ => transfer.Status.ToString()
    };
}

<div class="card" style="max-width: 1000px; margin: 0 auto; padding: 1.5rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 1.5rem; flex-wrap:wrap; gap:1rem;">
        <div>
            <div style="display:flex; align-items:center; gap:0.75rem;">
                <h2 style="margin:0; font-size:1.5rem;">Traslado @transfer.Number</h2>
                <span class="status-badge @statusClass" style="font-size:0.875rem; padding:4px 10px;">@statusLabel</span>
            </div>
            <p style="margin:0.25rem 0 0; color:var(--text-muted); font-size:0.875rem;">
                Trazabilidad de envío y recepción entre bodegas y sucursales
            </p>
        </div>
        <div style="display:flex; gap:0.5rem;">
            <a asp-action="Index" class="button-ghost link-button">← Volver al listado</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" style="margin-bottom:1.5rem; padding:0.75rem 1rem; border-radius:6px; background:rgba(16,185,129,0.1); border:1px solid #10b981; color:#065f46;">
            @success
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" style="margin-bottom:1.5rem; padding:0.75rem 1rem; border-radius:6px; background:rgba(239,68,68,0.1); border:1px solid #ef4444; color:#991b1b;">
            @error
        </div>
    }

    <!-- Metadata Section -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:1rem; background:var(--bg-muted, #f9fafb); padding:1.25rem; border-radius:8px; border:1px solid var(--border-color, #e5e7eb); margin-bottom:1.5rem;">
        <div>
            <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Bodega Origen</div>
            <div style="font-size:1rem; font-weight:600; margin-top:2px;">@transfer.OriginWarehouseName</div>
        </div>
        <div>
            <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Bodega Destino</div>
            <div style="font-size:1rem; font-weight:600; margin-top:2px;">@transfer.DestinationWarehouseName</div>
        </div>
        <div>
            <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Solicitado</div>
            <div style="font-size:0.875rem; margin-top:2px;">
                @transfer.RequestedAtUtc.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")
                <span style="color:var(--text-muted);">por @transfer.RequestedBy</span>
            </div>
        </div>
        @if (transfer.DispatchedAtUtc.HasValue)
        {
            <div>
                <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Despachado</div>
                <div style="font-size:0.875rem; margin-top:2px;">
                    @transfer.DispatchedAtUtc.Value.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")
                    <span style="color:var(--text-muted);">por @transfer.DispatchedBy</span>
                </div>
            </div>
        }
        @if (transfer.ReceivedAtUtc.HasValue)
        {
            <div>
                <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Recibido</div>
                <div style="font-size:0.875rem; margin-top:2px;">
                    @transfer.ReceivedAtUtc.Value.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")
                    <span style="color:var(--text-muted);">por @transfer.ReceivedBy</span>
                </div>
            </div>
        }
        @if (transfer.CancelledAtUtc.HasValue)
        {
            <div>
                <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:600;">Cancelado</div>
                <div style="font-size:0.875rem; margin-top:2px; color:#ef4444;">
                    @transfer.CancelledAtUtc.Value.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")
                    <span style="color:var(--text-muted);">por @transfer.CancelledBy</span>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(transfer.Observations))
    {
        <div style="margin-bottom:1.5rem; padding:0.75rem 1rem; background:rgba(59,130,246,0.05); border-left:4px solid #3b82f6; border-radius:4px;">
            <strong>Observaciones:</strong> @transfer.Observations
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(transfer.CancellationReason))
    {
        <div style="margin-bottom:1.5rem; padding:0.75rem 1rem; background:rgba(239,68,68,0.05); border-left:4px solid #ef4444; border-radius:4px;">
            <strong>Motivo de cancelación:</strong> @transfer.CancellationReason
        </div>
    }

    <!-- Items Table -->
    <div style="margin-bottom: 2rem;">
        <h3 style="font-size:1.125rem; margin-bottom:0.75rem;">Productos en el traslado</h3>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th style="text-align:right;">Cantidad enviada</th>
                        <th style="text-align:right;">Cantidad recibida</th>
                        <th style="text-align:right;">Costo origen</th>
                        <th style="text-align:right;">Costo asignado destino</th>
                        <th style="text-align:right;">Subtotal asignado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in transfer.Items)
                    {
                        var subtotalAssigned = item.QuantitySent * item.AssignedUnitCost;
                        <tr>
                            <td>
                                <strong>@item.ProductName</strong>
                                <div style="font-size:0.8rem; color:var(--text-muted);">@item.ProductCode</div>
                            </td>
                            <td style="text-align:right; font-weight:600;">@DisplayFormats.Quantity(item.QuantitySent)</td>
                            <td style="text-align:right; font-weight:600;">
                                @if (transfer.Status == InventoryTransferStatus.Received)
                                {
                                    <span style="color:#059669;">@DisplayFormats.Quantity(item.QuantityReceived)</span>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);">-</span>
                                }
                            </td>
                            <td style="text-align:right;">Q@(item.UnitCostOrigin.ToString("N4"))</td>
                            <td style="text-align:right; font-weight:600; color:#2563eb;">Q@(item.AssignedUnitCost.ToString("N4"))</td>
                            <td style="text-align:right; font-weight:600;">Q@(subtotalAssigned.ToString("N2"))</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:bold; background:var(--bg-muted, #f9fafb);">
                        <td>Total general</td>
                        <td style="text-align:right;">@DisplayFormats.Quantity(transfer.Items.Sum(x => x.QuantitySent))</td>
                        <td style="text-align:right;">
                            @if (transfer.Status == InventoryTransferStatus.Received)
                            {
                                @DisplayFormats.Quantity(transfer.Items.Sum(x => x.QuantityReceived))
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td colspan="2"></td>
                        <td style="text-align:right;">Q@(transfer.Items.Sum(x => x.QuantitySent * x.AssignedUnitCost).ToString("N2"))</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Actions Footer -->
    <div class="action-row" style="display:flex; justify-content:flex-end; gap:1rem; border-top:1px solid var(--border-color, #e5e7eb); padding-top:1.5rem;">
        @if (Model.CanCancel)
        {
            <form method="post" asp-action="Cancel" asp-route-id="@transfer.Id" id="formCancel">
                @Html.AntiForgeryToken()
                <input type="hidden" name="reason" value="Cancelado por usuario" />
                <button type="submit" class="button-ghost" id="btnCancel" style="color:#ef4444;">Cancelar traslado</button>
            </form>
        }

        @if (Model.CanDispatch)
        {
            <form method="post" asp-action="Dispatch" asp-route-id="@transfer.Id" id="formDispatch">
                @Html.AntiForgeryToken()
                <button type="submit" class="button-primary" id="btnDispatch">
                    <svg aria-hidden="true" viewBox="0 0 24 24" style="width:16px;height:16px;margin-right:6px;vertical-align:-2px;" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    Despachar traslado
                </button>
            </form>
        }

        @if (Model.CanReceive)
        {
            <form method="post" asp-action="Receive" asp-route-id="@transfer.Id" id="formReceive">
                @Html.AntiForgeryToken()
                <button type="submit" class="button-primary" id="btnReceive" style="background:#059669; border-color:#059669;">
                    <svg aria-hidden="true" viewBox="0 0 24 24" style="width:16px;height:16px;margin-right:6px;vertical-align:-2px;" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                    Recibir en bodega destino
                </button>
            </form>
        }
    </div>
</div>
