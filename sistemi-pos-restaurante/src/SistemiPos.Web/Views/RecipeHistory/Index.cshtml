@model SistemiPos.Web.Models.Recipes.RecipeHistoryViewModel
@inject SistemiPos.Application.Settings.ISettingsService Settings
@{ ViewData["Title"]="Versiones, costos y disponibilidad"; var selected=Model.Versions.First(x=>x.Id==Model.VersionId); var recipe=selected.Read(); var settings=await Settings.GetSystemSettingAsync(); }
<section class="page-header compact-page-header"><h1>@recipe.ProductName</h1><a asp-controller="Recipes" asp-action="Details" asp-route-id="@Model.RecipeId">Volver a receta</a></section>
<form method="get" class="form-card form-grid"><div class="field"><label for="version">Versión histórica</label><select id="version" name="versionId" class="input">@foreach(var v in Model.Versions){<option value="@v.Id" selected="@(v.Id==Model.VersionId)">v@v.Number · @v.EffectiveAtUtc.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")</option>}</select></div>
<div class="field"><label for="warehouse">Bodega</label><select id="warehouse" name="warehouseId" class="input" required>@foreach(var w in Model.Warehouses){<option value="@w.Id" selected="@(w.Id==Model.WarehouseId)">@w.Name</option>}</select></div>
<div class="field"><label for="quantity">Cantidad a elaborar (@recipe.YieldUnitCode)</label><input id="quantity" name="quantity" value="@Model.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0.000001" step="0.000001" class="input" required /></div>
<div class="field"><label for="date">Costos a fecha y hora (Guatemala)</label><input id="date" name="costDate" type="datetime-local" value="@Model.CostDate?.ToString("yyyy-MM-ddTHH:mm")" class="input" /><span class="helper-text">Vacío usa costos actuales. La disponibilidad siempre corresponde al inventario actual.</span></div><div class="action-row"><button class="button-primary" type="submit">Calcular</button></div></form>
@if(Model.Error is not null){<p class="validation" role="alert">@Model.Error</p>}
<p>Versión @selected.Number · Rendimiento por elaboración: @DisplayFormats.Quantity(recipe.YieldQuantity) @recipe.YieldUnitCode</p>
@if(Model.Quote is { } q){
<div class="stats-grid"><article class="stat-card"><span>Costo teórico del lote (@settings.CurrencyCode)</span><strong>@q.TotalCost.ToString("N6")</strong></article><article class="stat-card"><span>Costo por unidad (@settings.CurrencyCode)</span><strong>@q.UnitCost.ToString("N6")</strong></article><article class="stat-card"><span>Disponible para elaborar</span><strong>@DisplayFormats.Quantity(q.AvailableOutput) @recipe.YieldUnitCode</strong><small>Limita: @q.LimitingComponent</small></article></div>
@if(q.Lines.Any(x=>!x.Cost.Known)){<p class="validation">El costo está incompleto: hay componentes sin costo registrado para esa fecha.</p>}
<div class="table-card table-responsive"><table class="data-table"><thead><tr><th>Producto del inventario</th><th>Necesario</th><th>Disponible</th><th>Costo unitario (@settings.CurrencyCode)</th><th>Costo total (@settings.CurrencyCode)</th><th>Referencia</th></tr></thead><tbody>@foreach(var line in q.Lines){<tr><td>@line.Component.Code · @line.Component.Name</td><td>@DisplayFormats.Quantity(line.Required) @line.Component.BaseUnitCode</td><td>@DisplayFormats.Quantity(line.Available)</td><td>@line.Cost.UnitCost.ToString("N6")</td><td>@((line.Required * line.Cost.UnitCost).ToString("N6"))</td><td>@line.Cost.Source</td></tr>}</tbody></table></div>
}else{<div class="table-card"><table class="data-table"><thead><tr><th>Componente</th><th>Cantidad base por elaboración</th></tr></thead><tbody>@foreach(var c in recipe.Components){<tr><td>@c.Code · @c.Name</td><td>@DisplayFormats.Quantity(c.BaseQuantity) @c.BaseUnitCode</td></tr>}</tbody></table></div>}
@if(!string.IsNullOrWhiteSpace(recipe.Instructions)){<div class="form-card"><h2>Preparación</h2><p style="white-space:pre-wrap">@recipe.Instructions</p></div>}
