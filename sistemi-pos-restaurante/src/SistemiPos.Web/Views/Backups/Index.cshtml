@model SistemiPos.Application.Reports.BackupStatus
@{ViewData["Title"]="Respaldo y recuperación"; var last=Model.Files.FirstOrDefault(); var age=last is null ? (double?)null : (DateTimeOffset.UtcNow-last.CreatedAtUtc).TotalMinutes;}
<link rel="stylesheet" href="~/css/control.css" asp-append-version="true" />
<header class="control-heading"><div><h1>Respaldo y recuperación</h1><p>Archivos privados del servidor PostgreSQL.</p></div><form method="post" action="/control/respaldos/crear">@Html.AntiForgeryToken()<button class="button-primary" disabled="@(!Model.Configured)">Crear respaldo</button></form></header>
<div class="control-metrics"><article><span>Configuración</span><strong>@(Model.Configured?"Lista":"Pendiente")</strong></article><article><span>Automático</span><strong>@(Model.AutomaticEnabled?"Activado":"Desactivado")</strong></article><article><span>Retención</span><strong>@Model.RetentionDays días</strong></article><article><span>Objetivo RPO</span><strong>@(Model.RpoMinutes?.ToString()??"Sin definir") min</strong></article><article><span>Objetivo RTO</span><strong>@(Model.RtoMinutes?.ToString()??"Sin definir") min</strong></article></div>
@if(TempData["BackupMessage"] is string message){<p role="status">@message</p>}
@if(!Model.Configured){<p class="helper-text">Configura Backups:Directory y Backups:PgDumpPath en el servidor. La carpeta debe estar fuera del directorio público. Las claves de protección de datos y archivos adjuntos también deben incluirse en la política de recuperación del servidor.</p>}
@if(age.HasValue&&Model.RpoMinutes.HasValue&&age>Model.RpoMinutes){<p role="alert">El último respaldo supera la antigüedad definida por el objetivo RPO.</p>}
<p class="helper-text">La suma SHA256 comprueba integridad del archivo; no equivale a un simulacro de restauración. El RTO se mide restaurando en una base aislada con el procedimiento documentado.</p>
<div class="table-card"><table class="data-table"><thead><tr><th>Fecha UTC</th><th>Archivo</th><th>Tamaño</th><th>Integridad al crear</th><th>SHA256</th></tr></thead><tbody>@foreach(var file in Model.Files){<tr><td>@file.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@file.File</td><td>@file.Bytes.ToString("N0") bytes</td><td>@(file.Verified?"Archivo generado":"Revisar")</td><td><details><summary>Ver suma</summary>@file.Sha256</details></td></tr>}</tbody></table></div>
