@model SistemiPos.Application.Inventory.InventoryMovementPage
@{
    ViewData["Title"] = "Kardex";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Inventario</p>
        <h1>Kardex</h1>
    </div>
    <div class="actions">
        <a asp-action="Export" asp-route-productId="@(ViewData["ProductId"])" asp-route-branchId="@(ViewData["BranchId"])" asp-route-warehouseId="@(ViewData["WarehouseId"])" class="button-secondary link-button">Exportar a Excel</a>
    </div>
</section>

@if (ViewData["AvailableWarehouses"] is List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> whList && whList.Count > 0)
{
    <form method="get" asp-action="Kardex" class="filter-bar" style="margin-bottom: 1rem; display: flex; gap: 0.75rem; align-items: center;">
        <input type="hidden" name="productId" value="@(ViewData["ProductId"])" />
        <label for="warehouseId" style="font-weight: 600;">Bodega:</label>
        <select name="warehouseId" id="warehouseId" class="form-control" onchange="this.form.submit()" style="max-width: 280px;">
            <option value="">Todas las bodegas autorizadas</option>
            @foreach (var wh in whList)
            {
                <option value="@wh.Value" selected="@wh.Selected">@wh.Text</option>
            }
        </select>
    </form>
}

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Producto</th>
                <th>Bodega</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Anterior</th>
                <th>Nueva</th>
                <th>Usuario</th>
                <th>Documento</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.OccurredAtUtc.LocalDateTime.ToString("g")</td>
                <td>@item.ProductName</td>
                <td>@(item.WarehouseName ?? "Sin bodega")</td>
                <td>@item.Type</td>
                <td>@DisplayFormats.Quantity(item.Quantity)</td>
                <td>@DisplayFormats.Quantity(item.PreviousStock)</td>
                <td>@DisplayFormats.Quantity(item.NewStock)</td>
                <td>@item.UserName</td>
                <td>@item.SourceDocument</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav class="action-row" aria-label="Paginación del Kardex">
    @if (Model.Page > 1)
    {
        <a asp-action="Kardex" asp-route-productId="@(ViewData["ProductId"])" asp-route-branchId="@(ViewData["BranchId"])" asp-route-warehouseId="@(ViewData["WarehouseId"])" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" class="button-secondary link-button">Anterior</a>
    }
    else
    {
        <button type="button" class="button-secondary" disabled>Anterior</button>
    }
    <span>Página @Model.Page de @Model.TotalPages · @Model.TotalCount registros</span>
    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Kardex" asp-route-productId="@(ViewData["ProductId"])" asp-route-branchId="@(ViewData["BranchId"])" asp-route-warehouseId="@(ViewData["WarehouseId"])" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" class="button-secondary link-button">Siguiente</a>
    }
    else
    {
        <button type="button" class="button-secondary" disabled>Siguiente</button>
    }
</nav>
