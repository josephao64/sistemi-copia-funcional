@model IReadOnlyList<SistemiPos.Domain.Recipes.ProductionOrder>
@using SistemiPos.Domain.Recipes
@inject SistemiPos.Web.Services.INavigationPermissionService NavigationPermissions
@{ ViewData["Title"] = "Producción"; var permissions = await NavigationPermissions.GetPermissionCodesAsync(); }
<section class="page-header compact-page-header"><h1>Producción</h1>@if(permissions.Contains(PermissionCodes.ProductionManage)){<a asp-action="Create" class="button-primary link-button">+ Nueva producción</a>}</section>
<p>Órdenes de la sucursal activa. Cada confirmación registra el consumo y el rendimiento real juntos.</p>
<div class="table-card table-responsive"><table class="data-table"><thead><tr><th>Lote</th><th>Producto</th><th>Versión</th><th>Planificado</th><th>Real</th><th>Merma</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach(var order in Model){var recipe=order.RecipeVersion.Read();<tr><td>@order.LotNumber</td><td>@recipe.ProductName</td><td>@order.RecipeVersion.Number</td><td>@DisplayFormats.Quantity(order.PlannedQuantity) @recipe.YieldUnitCode</td><td>@(order.ActualQuantity?.ToString("0.######") ?? "Pendiente")</td><td>@DisplayFormats.Quantity(order.WasteQuantity)</td><td>@(order.Status == ProductionStatus.Confirmed ? "Confirmada" : "Borrador")</td><td><a asp-action="Details" asp-route-id="@order.Id">Ver detalle</a></td></tr>}
@if(Model.Count == 0){<tr><td colspan="8">No hay órdenes de producción en esta sucursal.</td></tr>}
</tbody></table></div>
